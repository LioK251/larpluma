<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" x:Class="GreenLuma_Manager.Dialogs.CustomMessageBox" Title="Message" Width="480" MinHeight="220" MaxHeight="600" Background="{DynamicResource DarkBg}" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" Topmost="True" WindowStartupLocation="CenterOwner" xmlns:controls="clr-namespace:GreenLuma_Manager.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:TitleBar xmlns:controls="clr-namespace:GreenLuma_Manager.Controls" />
        <Border Grid.Row="1" Padding="24,20">
            <StackPanel>
                <Path Name="IconPath" Width="14" Height="14" Margin="0,0,0,10" Stretch="Uniform" HorizontalAlignment="Left" />
                <TextBlock Name="MessageText" VerticalAlignment="Center" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource TextSecond}" LineHeight="22" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Padding="24,16" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <StackPanel Name="ButtonPanel" HorizontalAlignment="Right" Orientation="Horizontal" />
        </Border>
    </Grid>
</Window>