<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GreenLuma_Manager.Controls" Style="{StaticResource {x:Type Window}}" x:Class="GreenLuma_Manager.MainWindow" Title="Larpluma" Width="1120" Height="760" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{DynamicResource DarkBg}" Icon="icon.ico">
    <Window.Resources>
        <Style x:Key="ProfileRowContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProfileCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Style.Triggers>
                            <Trigger Property="Content" Value="__empty__">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ProfileGameRow">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="{DynamicResource ProfileRowPadding}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Move up" Click="MoveGameUp_Click" />
                        <MenuItem Header="Move down" Click="MoveGameDown_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MouseLeftButtonDown="GameName_MouseLeftButtonDown" ToolTip="Double-click to rename">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" KeyDown="GameNameEdit_KeyDown" LostFocus="GameNameEdit_LostFocus" IsVisibleChanged="GameNameEdit_IsVisibleChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Type}" Style="{StaticResource Muted}" />
                            <TextBlock Text=" · " Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding AppId}" Style="{StaticResource Muted}" FontFamily="Consolas" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveGameButton_Click" Style="{StaticResource RemoveBtn}" ToolTip="Remove from profile" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding GenerateApplistCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LaunchGreenlumaCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ToggleStealthCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding CycleProfileCommand}" />
    </Window.InputBindings>
    <Grid>
        <controls:BackgroundLayer x:Name="Backdrop" IsHitTestVisible="False" />
        <Grid x:Name="Shell">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <controls:TitleBar xmlns:controls="clr-namespace:GreenLuma_Manager.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="WindowTitleBar" Caption="larpluma" ShowMinimize="True">
                <controls:TitleBar.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button ToolTip="Project repository" AutomationProperties.Name="Project repository" Click="GitHubButton_Click" Style="{StaticResource CaptionButton}">
                            <Path Data="M5 10 L10 5 M7 3 L9 1 H13 V5 L11 7 M7 11 L5 13 H1 V9 L3 7" Width="14" Height="14" Stroke="{DynamicResource TextSecond}" StrokeThickness="1.2" />
                        </Button>
                        <Button ToolTip="Restart Steam without GreenLuma" AutomationProperties.Name="Restart Steam without GreenLuma" Click="RestartSteam_Click" Style="{StaticResource CaptionButton}">
                            <Path Data="M12 5 A5 5 0 1 0 12 10 M12 1 V5 H8" Width="14" Height="14" Stroke="{DynamicResource TextSecond}" StrokeThickness="1.2" />
                        </Button>
                        <Button ToolTip="Plugins" AutomationProperties.Name="Plugins" Click="ManagePluginsButton_Click" Style="{StaticResource CaptionButton}">
                            <Path Data="M3 2 H6 V0 H10 V2 H13 V6 H15 V10 H13 V13 H9 V15 H5 V13 H3 V9 H0 V5 H3 Z" Width="16" Height="16" Stroke="{DynamicResource TextSecond}" StrokeThickness="1.2" />
                        </Button>
                        <Button ToolTip="Settings" AutomationProperties.Name="Settings" Click="SettingsButton_Click" Style="{StaticResource CaptionButton}">
                            <Path Data="M1 3 H15 M1 8 H15 M1 13 H15 M5 1 V5 M11 6 V10 M6 11 V15" Width="16" Height="16" Stroke="{DynamicResource TextSecond}" StrokeThickness="1.2" />
                        </Button>
                    </StackPanel>
                </controls:TitleBar.Actions>
            </controls:TitleBar>
            <Border x:Name="PluginToolbar" Grid.Row="1" Visibility="Collapsed" Padding="18,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PnlPluginButtons" Orientation="Horizontal" />
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="WorkspaceViewport" Grid.Row="2" Margin="22,18,22,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Width="{Binding ViewportWidth, ElementName=WorkspaceViewport}" Height="{Binding ActualHeight, ElementName=WorkspaceViewport}" MinHeight="{DynamicResource WorkspaceMinHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SearchColumn" Width="1.55*" MinWidth="460" />
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Search Steam" Style="{StaticResource HeaderTxt}" />
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="TxtSearchInput" AutomationProperties.Name="Search Steam by name, link or App ID" KeyDown="SearchInput_KeyDown" GotFocus="SearchInput_GotFocus" LostFocus="SearchInput_LostFocus" />
                                <TextBlock x:Name="TxtSearchPlaceholder" Text="Game name, Steam link, or App ID" Style="{StaticResource PlaceholderTxt}" />
                            </Grid>
                            <Button x:Name="BtnSearch" Grid.Column="1" Margin="8,0,0,0" Content="Search" Click="SearchButton_Click" Style="{StaticResource PrimaryBtn}" />
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Bundled name search · add an API key for current coverage" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <Grid Grid.Row="3">
                            <Grid x:Name="SearchResultsPane">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="PnlResultsHeader" Visibility="Collapsed">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button x:Name="BtnAddAll" DockPanel.Dock="Right" Content="Add all" Click="AddAllGames_Click" Style="{StaticResource IconBtn}" />
                                        <TextBlock x:Name="TxtResultCount" Text="0 results" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <WrapPanel Margin="0,0,0,12">
                                        <RadioButton x:Name="FilterAll" Content="All" GroupName="ResultType" IsChecked="True" Checked="ResultFilter_Changed" />
                                        <RadioButton x:Name="FilterGames" Content="Games" GroupName="ResultType" Checked="ResultFilter_Changed" />
                                        <RadioButton x:Name="FilterDlc" Content="DLC" GroupName="ResultType" Checked="ResultFilter_Changed" />
                                        <RadioButton x:Name="FilterOther" Content="Other" GroupName="ResultType" Checked="ResultFilter_Changed" />
                                        <ToggleButton x:Name="BtnHideAdded" Content="Hide added" Checked="ResultFilter_Changed" Unchecked="ResultFilter_Changed" Margin="8,0" />
                                    </WrapPanel>
                                </StackPanel>
                                <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="DgResults" Grid.Row="1" Visibility="Collapsed" SelectionChanged="SearchSelection_Changed" MouseDoubleClick="SearchResult_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="SizeToCells" />
                                        <DataGridTextColumn Header="App ID" Binding="{Binding AppId}" Width="SizeToCells" />
                                        <DataGridTemplateColumn Width="SizeToCells">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Add" Tag="{Binding}" Click="AddGameButton_Click" Style="{StaticResource IconBtn}" MinHeight="0" Padding="8,2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel x:Name="PnlEmptyResults" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Find a game to get started" HorizontalAlignment="Center" />
                                    <TextBlock Text="Ctrl+F to focus search" Style="{StaticResource Muted}" Margin="0,8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="PnlSearchLoading" Visibility="Collapsed" Background="{DynamicResource DarkBg}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="Searching Steam" Foreground="{DynamicResource TextSecond}" />
                                    <TextBlock x:Name="TxtLoadingDots" Text="." />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="DetailPane" Visibility="Collapsed" Background="{DynamicResource SurfaceBg}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Button Content="← Results" DockPanel.Dock="Left" Click="BackToResults_Click" Style="{StaticResource IconBtn}" />
                                    <Button Content="Retry" DockPanel.Dock="Right" Click="RetryDetails_Click" Style="{StaticResource IconBtn}" />
                                    <Button x:Name="BtnUnknown" Content="Add unknown ID" DockPanel.Dock="Right" Click="AddUnknown_Click" Visibility="Collapsed" Style="{StaticResource IconBtn}" />
                                </DockPanel>
                                <StackPanel Grid.Row="1" Margin="0,16,0,12">
                                    <TextBlock x:Name="DetailTitle" Text="Loading game…" FontSize="{DynamicResource HeadingSize}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                                <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                                    <Button Content="Select all" Click="SelectAllDetails_Click" Style="{StaticResource IconBtn}" />
                                    <Button Content="Clear selection" Click="ClearDetails_Click" Style="{StaticResource IconBtn}" />
                                </WrapPanel>
                                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="DgDetails" IsReadOnly="False" SelectionMode="Extended">
                                            <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="40">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Margin="0" VerticalAlignment="Center" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Game.Name}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Game / App" Binding="{Binding Game.Name}" Width="*" IsReadOnly="True" />
                                                <DataGridTextColumn Header="App ID" Binding="{Binding Game.AppId}" Width="SizeToCells" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Label}" Width="SizeToCells" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Expander x:Name="AdditionalContent" Header="Additional content" Style="{StaticResource AdditionalContentExpander}" Visibility="Collapsed" Margin="0,8,0,0" Expanded="AdditionalContent_Expanded" Collapsed="AdditionalContent_Collapsed">
                                            <StackPanel>
                                            <TextBlock x:Name="AdditionalStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <Button x:Name="BtnRetryContent" Content="Retry content" Click="RetryContent_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                            <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="DgAdditional" MaxHeight="300" PreviewMouseWheel="Content_PreviewMouseWheel" VirtualizingPanel.VirtualizationMode="Recycling" IsReadOnly="False" SelectionMode="Extended">
                                                <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="40">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Margin="0" VerticalAlignment="Center" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Game.Name}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Additional content" Binding="{Binding Game.Name}" Width="*" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="App ID" Binding="{Binding Game.AppId}" Width="SizeToCells" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Label}" Width="SizeToCells" IsReadOnly="True" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                                <Button x:Name="BtnAddSelected" Grid.Row="4" Margin="0,16,0,0" Content="Add selected to profile" Click="AddSelectedDetails_Click" Style="{StaticResource PrimaryBtn}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Border}" ResizeBehavior="PreviousAndNext" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Profile" Style="{StaticResource HeaderTxt}" />
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbProfile" SelectionChanged="ProfileComboBox_SelectionChanged" Style="{StaticResource ProfileCombo}" AutomationProperties.Name="Current profile" />
                            <ToggleButton Grid.Column="1" x:Name="BtnProfileOptions" Content="···" Margin="8,0,0,0" Click="ProfileOptionsButton_Click" ToolTip="Profile actions">
                                <ToggleButton.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Create profile" Click="CreateProfileButton_Click" />
                                        <MenuItem Header="Import profile" Click="ImportProfileButton_Click" />
                                        <MenuItem Header="Load AppList" Click="LoadAppListButton_Click" />
                                        <MenuItem Header="Export profile" Click="ExportProfileButton_Click" />
                                        <Separator />
                                        <MenuItem Header="Clear profile" Click="ClearProfileButton_Click" />
                                        <MenuItem Header="Delete profile" Click="DeleteProfileButton_Click" />
                                    </ContextMenu>
                                </ToggleButton.ContextMenu>
                            </ToggleButton>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="TxtGameCount" Text="No games" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="155" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="TxtGameSearch" GotFocus="TxtGameSearch_GotFocus" LostFocus="TxtGameSearch_LostFocus" TextChanged="TxtGameSearch_TextChanged" AutomationProperties.Name="Filter profile" />
                                    <TextBlock x:Name="TxtGameSearchPlaceholder" Text="Filter profile…" Style="{StaticResource PlaceholderTxt}" />
                                </Grid>
                                <ComboBox x:Name="CmbUnlockMethod" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="CmbUnlockMethod_SelectionChanged" AutomationProperties.Name="DLC unlocking method" ToolTip="Change the DLC unlocking method">
                                    <ComboBoxItem Content="GreenLuma" />
                                    <ComboBoxItem Content="CreamInstaller" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Row="3" x:Name="MainGameListContainer">
                                <ListBox x:Name="LstGames" Style="{x:Null}" ItemContainerStyle="{StaticResource ProfileRowContainer}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}" Padding="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <ContentControl Content="{Binding Game}" ContentTemplate="{StaticResource ProfileGameRow}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="Parent game is not included in the filtered profile">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Margin" Value="0,6" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasGame}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Expander Header="{Binding ContentLabel}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" Expanded="ProfileContent_Expanded">
                                                    <Expander.Style>
                                                        <Style TargetType="Expander" BasedOn="{StaticResource AdditionalContentExpander}">
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasChildren}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Expander.Style>
                                                    <ListBox MaxHeight="300" PreviewMouseWheel="Content_PreviewMouseWheel" ItemTemplate="{StaticResource ProfileGameRow}" ItemContainerStyle="{StaticResource ProfileRowContainer}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}" Padding="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                                        <ListBox.Style>
                                                            <Style TargetType="ListBox">
                                                                <Setter Property="ItemsSource" Value="{x:Null}" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True"><Setter Property="ItemsSource" Value="{Binding Children}" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </ListBox.Style>
                                                    </ListBox>
                                                </Expander>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            <StackPanel x:Name="PnlEmptyGames" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Your profile is empty" />
                                <TextBlock Text="Add games from Steam search" Style="{StaticResource Muted}" Margin="0,8" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="4" Margin="0,16,0,0">
                            <DockPanel Margin="0,0,0,12">
                                <ToggleButton x:Name="TglStealthMode" Content="Stealth mode" DockPanel.Dock="Right" Checked="NoHook_Toggled" Unchecked="NoHook_Toggled" />
                                <TextBlock Text="Launch options" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Button x:Name="BtnGenerateApplist" Content="Generate AppList" Click="GenerateApplistButton_Click" Margin="0,0,0,8" />
                            <Button x:Name="BtnUninstallUnlocker" Content="Uninstall DLC unlocker" Click="UninstallUnlocker_Click" Visibility="Collapsed" Margin="0,0,0,8" />
                            <Button x:Name="BtnLaunchGreenluma" Content="Launch GreenLuma" Click="LaunchGreenlumaButton_Click" Style="{StaticResource PrimaryBtn}" />
                            <StackPanel x:Name="PnlAppListProgress" Visibility="Collapsed" Margin="0,12,0,0">
                                <ProgressBar x:Name="AppListProgressBar" Height="3" Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}" />
                                <TextBlock x:Name="TxtAppListProgress" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                <Button x:Name="BtnCancelUnlocker" Content="Cancel after current game" Click="CancelUnlocker_Click" Visibility="Collapsed" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DockPanel Margin="24,0">
                    <TextBlock DockPanel.Dock="Right" Text="Larpluma 0.1.2 · by LioK251" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle x:Name="StatusIndicator" Width="5" Height="5" Fill="{DynamicResource Success}" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtStatus" Text="Ready" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="TxtVersionDot" Text=" · " Visibility="Collapsed" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="TxtGreenLumaVersionStatus" Style="{StaticResource Muted}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
        <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,48" Padding="16,12" MaxWidth="700" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="0">
            <StackPanel Orientation="Horizontal">
                <Path x:Name="ToastIcon" Data="M0 6 L4 10 L12 0" Stroke="{DynamicResource Text}" StrokeThickness="1.5" Width="12" Height="12" Margin="0,0,12,0" />
                <TextBlock x:Name="ToastMessage" TextWrapping="Wrap" MaxWidth="620" />
            </StackPanel>
        </Border>
        <Grid x:Name="PnlWebView2Host" Visibility="Collapsed" />
    </Grid>
</Window>
